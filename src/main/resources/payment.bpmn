  <bpmn:process id="PaymentProcess" name="Payment Process" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:sequenceFlow id="Flow_0mfi4vt" sourceRef="StartEvent_1" targetRef="Activity_1t4szk3" />
    <bpmn:sequenceFlow id="Flow_0qy3hx0" sourceRef="Activity_1t4szk3" targetRef="Gateway_0sglth5" />
    <bpmn:exclusiveGateway id="Gateway_0sglth5" name="Credit sufficient?">
      <bpmn:incoming>Flow_0qy3hx0</bpmn:incoming>
      <bpmn:outgoing>Flow_11x9qxa</bpmn:outgoing>
      <bpmn:outgoing>Flow_0g3ownw</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_1w12dtm">
      <bpmn:incoming>Flow_11x9qxa</bpmn:incoming>
      <bpmn:incoming>Flow_1wvfnh1</bpmn:incoming>
      <bpmn:outgoing>Flow_17lnpb7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_11x9qxa" name="Yes" sourceRef="Gateway_0sglth5" targetRef="Gateway_1w12dtm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${openAmount == 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0g3ownw" name="No" sourceRef="Gateway_0sglth5" targetRef="Activity_1ali4qt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${openAmount &gt; 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1wvfnh1" sourceRef="Activity_1ali4qt" targetRef="Gateway_1w12dtm" />
    <bpmn:sequenceFlow id="Flow_17lnpb7" sourceRef="Gateway_1w12dtm" targetRef="Payment_PaymentCompletedEndEvent" />
    <bpmn:serviceTask id="Activity_1t4szk3" name="Deduct credit" camunda:delegateExpression="${deductCredit}">
      <bpmn:incoming>Flow_0mfi4vt</bpmn:incoming>
      <bpmn:outgoing>Flow_0qy3hx0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1ali4qt" name="Charge credit card" camunda:asyncBefore="true" camunda:delegateExpression="${chargeCreditCard}">
      <bpmn:incoming>Flow_0g3ownw</bpmn:incoming>
      <bpmn:outgoing>Flow_1wvfnh1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="StartEvent_1" name="Payment requested" camunda:asyncAfter="true">
      <bpmn:outgoing>Flow_0mfi4vt</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0qo2hip" messageRef="Message_2tu948g" />
    </bpmn:startEvent>
    <bpmn:endEvent id="Payment_PaymentCompletedEndEvent" name="Payment completed">
      <bpmn:incoming>Flow_17lnpb7</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0hwo17h" camunda:delegateExpression="${completePayment}" />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Event_0ki76ne" name="Invalid expiry date" attachedToRef="Activity_1ali4qt">
      <bpmn:outgoing>Flow_1ikjvhl</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1ddmiin" errorRef="Error_0p41hi6" camunda:errorCodeVariable="" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1ikjvhl" sourceRef="Event_0ki76ne" targetRef="Payment_InvalidExpiryDateCompensationEvent" />
    <bpmn:endEvent id="Event_1xqrumn" name="Payment failed">
      <bpmn:incoming>Flow_0mgey93</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_09lxcru" camunda:delegateExpression="${completePayment}" />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Event_08w1cni" name="Invalid expiry date" attachedToRef="Activity_1t4szk3">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_0jgsilb" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_0mgey93" sourceRef="Payment_InvalidExpiryDateCompensationEvent" targetRef="Event_1xqrumn" />
    <bpmn:intermediateThrowEvent id="Payment_InvalidExpiryDateCompensationEvent" name="Invalid expiry date">
      <bpmn:incoming>Flow_1ikjvhl</bpmn:incoming>
      <bpmn:outgoing>Flow_0mgey93</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_09zf1eo" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="Payment_RefundCreditTask" name="Refund credit" isForCompensation="true" camunda:type="external" camunda:topic="credit-refund" />
    <bpmn:association id="Association_0si13j3" associationDirection="One" sourceRef="Event_08w1cni" targetRef="Payment_RefundCreditTask" />
  </bpmn:process>
